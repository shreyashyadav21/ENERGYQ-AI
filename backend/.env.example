# ENERGYQ AI Configuration
PORT=8000
HOST=0.0.0.0

# Optional Supabase integration (in-memory SQLite fallback used when omitted)
SUPABASE_URL=
SUPABASE_KEY=
# Set this to the project's Supabase JWT secret. Production command APIs fail closed without it.
SUPABASE_JWT_SECRET=
# Demo mode is for the in-memory simulator only. Disable for any shared or deployed environment.
ENERGYQ_DEMO_MODE=false

# Optional MQTT Broker (in-memory simulator broker used when omitted)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=energyq/telemetry

# Optional Sarvam AI Multilingual Voice API Key
SARVAM_API_KEY=
